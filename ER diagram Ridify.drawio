        <mxCell id="note1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacing=8;fontSize=11;" value="&lt;b&gt;Rules enforced outside the ER diagram&lt;/b&gt;&lt;br&gt;- A driver cannot accept overlapping active rides (trigger/transaction)&lt;br&gt;- Only VERIFIED drivers may accept rides (application authorization)&lt;br&gt;- Ride status transitions are controlled; CANCELLED can never become ONGOING or COMPLETED&lt;br&gt;- Deleting a user must not remove payment history (RESTRICT / inactive status)&lt;br&gt;- Ride.Status: REQUESTED, ACCEPTED, ONGOING, COMPLETED, CANCELLED" vertex="1">
          <mxGeometry height="150" width="340" x="40" y="470" as="geometry" />
        </mxCell>
